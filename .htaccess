# Force PHP 8.2 execution (EasyApache 4 handler) in case the server
# isn't picking up the account's PHP Selector setting for this domain
<FilesMatch "\.php$">
  SetHandler application/x-httpd-ea-php82
</FilesMatch>

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Block direct access to stored newsletter-signup data
RewriteRule ^partials/data/ - [F,L]

RewriteEngine On

# Force HTTPS and non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Generate the RSS feed from current blog metadata.
RewriteRule ^rss\.xml$ rss.php [L]

# Generate the sitemap dynamically, even if an old XML file remains on the server.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Legacy "Thought Engines" URLs now live at /pages/bright-dark
RewriteRule ^(pages/thought-engines(\.php)?|projects/thought-engines)/?$ /pages/bright-dark [R=301,L,NC]

# Redirect /page.php to /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Internally load /page as /page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
