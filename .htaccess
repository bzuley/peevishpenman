# Force PHP 8.2 execution (EasyApache 4 handler) in case the server
# isn't picking up the account's PHP Selector setting for this domain
<FilesMatch "\.php$">
  SetHandler application/x-httpd-ea-php82
</FilesMatch>

Options -Indexes

# Missing pages get the site's own 404 page (which also answers 404).
ErrorDocument 404 /404.php

# HSTS: browsers that have seen the site over HTTPS stick to HTTPS for a
# year. Deliberately no includeSubDomains or preload.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  # Browsers use each file's declared type instead of guessing one.
  Header always set X-Content-Type-Options "nosniff"
  # Only this site may show its pages in a frame (stops clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  # Other sites see where a visitor came from, not the full page URL.
  # setifempty leaves pages that send their own (newsletter-admin) alone.
  Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
  # Features the site never uses stay off.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Browser caching. CSS and JS are cached for a year: every page links them
# through ppm_asset() (partials/assets.php), which adds the file's
# modification time to the URL, so a deploy still reaches browsers at once.
# Images aren't versioned that way, so they get a month.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Block direct access to stored newsletter-signup data
RewriteRule ^partials/data/ - [F,L]

RewriteEngine On

# Force HTTPS and non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Generate the RSS feed from current blog metadata.
RewriteRule ^rss\.xml$ rss.php [L]

# Generate the sitemap dynamically, even if an old XML file remains on the server.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Legacy "Thought Engines" URLs now live at /pages/bright-dark
RewriteRule ^(pages/thought-engines(\.php)?|projects/thought-engines)/?$ /pages/bright-dark [R=301,L,NC]

# Shorthand /pages/delcath now lives at /pages/delcath-series
RewriteRule ^pages/delcath(\.php)?/?$ /pages/delcath-series [R=301,L,NC]

# Shorthand /pages/wss-handbook now lives at /pages/writer-secret-society
RewriteRule ^pages/wss-handbook(\.php)?/?$ /pages/writer-secret-society [R=301,L,NC]

# The standalone newsletter page was removed; the sign-up form lives in the site footer
RewriteRule ^pages/newsletter(\.php)?/?$ /#newsletter [R=301,L,NC,NE]

# Old URLs from Search Console's 404 report
RewriteRule ^projects/handbook/?$ /pages/writer-secret-society [R=301,L,NC]
RewriteRule ^newsletter/?$ /#newsletter [R=301,L,NC,NE]
RewriteRule ^contact/?$ /pages/about [R=301,L,NC]
# Old Blogger-era URL of the Asimov reading list
RewriteRule ^blogs/peevish-penman/10-modern-books-for-fans-of-isaac-asimov/?$ /articles/10-modern-books-for-fans-of-isaac-asimov [R=301,L,NC]

# "Blog" was renamed to "Articles" sitewide.
# Each old URL, with or without .php or a trailing slash, goes to its
# final clean URL in a single 301 hop.
RewriteRule ^blogs?(\.php)?/?$ /articles [R=301,L,NC]
RewriteRule ^blogs/(.+?)(\.php)?/?$ /articles/$1 [R=301,L,NC]
RewriteRule ^blog-tag(\.php)?/?$ /article-tag [R=301,L,NC,QSA]

# Legacy /articles/peevish-penman/<slug> URLs from the old site.
# Slugs that changed are mapped one by one; any other slug that matches
# an existing article goes to /articles/<slug>.
RewriteRule ^articles/peevish-penman/meditation-and-closed-eye-visualizations/?$ /articles/closed-eye-visualizations [R=301,L,NC]
RewriteCond %{DOCUMENT_ROOT}/articles/$1.php -f
RewriteRule ^articles/peevish-penman/([^/]+?)/?$ /articles/$1 [R=301,L]

# Legacy Blogger post URLs (/YYYY/MM/<slug>.html, optionally with
# Blogger's ?m=1 mobile flag) go to /articles/<slug> when that article
# exists. Posts whose slug changed need their own line above this one.
RewriteCond %{DOCUMENT_ROOT}/articles/$1.php -f
RewriteRule ^\d{4}/\d{2}/([^/]+?)\.html$ /articles/$1 [R=301,L,QSD]

# Old Blogger-style label URLs (/tagged/<tag>) go to the tag landing page.
# Retired tags go straight to the tag they were merged into (one hop);
# any other tag goes to /article-tag, which 301s merged tags or answers
# its own 404 for tags that do not exist.
RewriteRule ^tagged/selfpublishing/?$ /article-tag?tag=independentpublishing [R=301,L,NC]
RewriteRule ^tagged/sciencefiction/?$ /article-tag?tag=speculativefiction [R=301,L,NC]
RewriteRule ^tagged/([A-Za-z0-9_-]+)/?$ /article-tag?tag=$1 [R=301,L,NC]

# Old slug of the Magician archetype article
RewriteRule ^(?:articles/)?magician-archetype/?$ /articles/the-magician [R=301,L,NC]

# The contact page was removed; the About page is where readers reach OA Allen
RewriteRule ^pages/contact(\.php)?/?$ /pages/about [R=301,L,NC]

# The articles listing shares its clean URL with the articles/ post
# directory, so the generic directory-checked rule below would treat
# /articles as a directory request. Route it explicitly first, and stop
# mod_dir from 301ing the canonical /articles to /articles/ on its own.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
RewriteRule ^articles/?$ articles.php [L]

# The homepage lives at /, not /index or /index.php
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^index(\.php)?$ / [R=301,L,NC]

# Redirect /page.php to /page. GET/HEAD only: browsers turn a redirected
# POST into a GET and drop the form data, which would lose submissions.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Internally load /page as /page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
