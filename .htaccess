# Force PHP 8.2 execution (EasyApache 4 handler) in case the server
# isn't picking up the account's PHP Selector setting for this domain
<FilesMatch "\.php$">
  SetHandler application/x-httpd-ea-php82
</FilesMatch>

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Block direct access to stored newsletter-signup data
RewriteRule ^partials/data/ - [F,L]

RewriteEngine On

# Force HTTPS and non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Generate the RSS feed from current blog metadata.
RewriteRule ^rss\.xml$ rss.php [L]

# Generate the sitemap dynamically, even if an old XML file remains on the server.
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Legacy "Thought Engines" URLs now live at /pages/bright-dark
RewriteRule ^(pages/thought-engines(\.php)?|projects/thought-engines)/?$ /pages/bright-dark [R=301,L,NC]

# Shorthand /pages/delcath now lives at /pages/delcath-series
RewriteRule ^pages/delcath(\.php)?/?$ /pages/delcath-series [R=301,L,NC]

# Shorthand /pages/wss-handbook now lives at /pages/writer-secret-society
RewriteRule ^pages/wss-handbook(\.php)?/?$ /pages/writer-secret-society [R=301,L,NC]

# The standalone newsletter page was removed; the sign-up form lives in the site footer
RewriteRule ^pages/newsletter(\.php)?/?$ /#newsletter [R=301,L,NC,NE]

# "Blog" was renamed to "Articles" sitewide.
# Each old URL, with or without .php or a trailing slash, goes to its
# final clean URL in a single 301 hop.
RewriteRule ^blogs?(\.php)?/?$ /articles [R=301,L,NC]
RewriteRule ^blogs/(.+?)(\.php)?/?$ /articles/$1 [R=301,L,NC]
RewriteRule ^blog-tag(\.php)?/?$ /article-tag [R=301,L,NC,QSA]

# The articles listing shares its clean URL with the articles/ post
# directory, so the generic directory-checked rule below would treat
# /articles as a directory request. Route it explicitly first, and stop
# mod_dir from 301ing the canonical /articles to /articles/ on its own.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
RewriteRule ^articles/?$ articles.php [L]

# The homepage lives at /, not /index or /index.php
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^index(\.php)?$ / [R=301,L,NC]

# Redirect /page.php to /page. GET/HEAD only: browsers turn a redirected
# POST into a GET and drop the form data, which would lose submissions.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L]

# Internally load /page as /page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
